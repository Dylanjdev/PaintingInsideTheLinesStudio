{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paintinginsidethelinesstudio",
  "compatibility_date": "2026-08-20",
  "main": "worker/index.js",
  "routes": [
    {
      "pattern": "paintingoutsidethelinesstudios.com",
      "custom_domain": true
    },
    {
      "pattern": "www.paintingoutsidethelinesstudios.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pits-db",
      "database_id": "e1f4e94f-b58e-47d9-8fd6-5ecbf89a552c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "pits-images"
    }
  ],
  "vars": {
    "SITE_URL": "https://paintingoutsidethelinesstudios.com"
  }
}
